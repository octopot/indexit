{
  "x-release": {
    "tag_pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
    "notes": "docs/content/changelog/{tag}.md",
    "branches": []
  },
  "secrets": {
    "HOMEBREW_TAP_APP_CLIENT_ID": { "scope": "organization" },
    "HOMEBREW_TAP_APP_KEY": { "scope": "organization" }
  },
  "pages": {
    "cname": "indexit.octolab.org",
    "https_enforced": true,
    "build_type": "workflow"
  }
}
